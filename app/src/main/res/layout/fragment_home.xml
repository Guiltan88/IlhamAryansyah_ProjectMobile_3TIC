<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF3E8"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <!-- SAPAAN -->

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo, Sobat EcoPlant!"
            android:textColor="#185B2B"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Yuk kenali tanaman di sekitarmu."
            android:textColor="#7B857C"
            android:textSize="13sp" />

        <!-- PENCARIAN -->

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:hint="⌕  Cari tanaman"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textColorHint="#7B857C"
            android:textSize="13sp"
            android:imeOptions="actionSearch" />

        <!-- BANNER UTAMA -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#176B2A"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kenali tanamanmu"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroDesc"
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvHeroTitle"
                    android:layout_marginTop="5dp"
                    android:text="Pelajari nama, manfaat, dan cara merawat tanaman dengan mudah."
                    android:textColor="#EAF5EA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnExplore"
                    android:layout_width="108dp"
                    android:layout_height="34dp"
                    android:layout_below="@id/tvHeroDesc"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_white"
                    android:backgroundTint="#FFFFFF"
                    android:text="Jelajahi"
                    android:textAllCaps="false"
                    android:textColor="#185E20"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.25"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ecoplant_logo" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- KATEGORI TANAMAN -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Kategori Tanaman"
            android:textColor="#185B2B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- KATEGORI HIAS -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCategoryHias"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Tanaman hias"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tanaman_hias" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#66000000"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:text="Hias"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- KATEGORI PANGAN -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCategoryPangan"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Tanaman pangan"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tanaman_pangan" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#66000000"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:text="Pangan"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- KATEGORI OBAT -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCategoryObat"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Tanaman obat"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tanaman_obat" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#66000000"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:text="Obat"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- KATEGORI POHON -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCategoryPohon"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Pohon"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pohon" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#66000000"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:text="Pohon"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tanaman Populer"
            android:textColor="#185B2B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPopularPlant"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="Monstera Deliciosa"
                    android:scaleType="centerCrop"
                    android:src="@drawable/monstera_deliciosa" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monstera Deliciosa"
                        android:textColor="#185B2B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tanaman hias • Indoor"
                        android:textColor="#7B857C"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Jelajahi tanaman →"
                        android:textColor="#207A33"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>