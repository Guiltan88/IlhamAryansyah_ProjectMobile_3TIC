<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:padding="12dp"
    android:background="@drawable/bg_card">

    <ImageView
        android:id="@+id/ivPlantImage"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Foto tanaman"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvPlantName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Monstera Deliciosa"
        android:textColor="#185B2B"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivPlantImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivPlantImage" />

    <TextView
        android:id="@+id/tvPlantCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="Tanaman Hias"
        android:textColor="#7B857C"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/ivPlantImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPlantName" />

    <TextView
        android:id="@+id/tvPlantDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="Hijau dan menyegarkan"
        android:textColor="#207A33"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/ivPlantImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPlantCategory" />

</androidx.constraintlayout.widget.ConstraintLayout>
